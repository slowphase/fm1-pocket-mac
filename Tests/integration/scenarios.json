{
 "about": "Representative firmwares for the app-level integration test (FM1Pocket --integration; Sources/FM1Pocket/IntegrationTest.swift). Paths are relative to this file: build/packages holds the makers' original packages (Tests/emu-packages.json), build/rfm1 the .rfm1 builds from FM-1 Pocket Player's published catalogue (both downloaded by CI with their SHA-256 checked). 'expect' lists the steps that must make sound; the rest are recorded. Save recipes use each firmware's own controls.",
 "firmwares": [
  {"id": "felucca", "kind": "keyboard synth, saves user presets with SAVE then OCT+ twice", "file": "../../build/packages/felucca.fwsc",
   "expect": ["keys", "computer", "midi"],
   "save": {"steps": ["turn:2:3", "wait:1000", "tap:SAVE", "wait:800", "tap:OCT+", "wait:800", "tap:OCT+", "wait:2500"],
            "view": ["tap:HOME", "wait:600", "tap:SAVE", "wait:1200"], "screen": "differsFromFresh"},
   "other": "../../build/rfm1/felucca.rfm1"},
  {"id": "felucca-rfm1", "kind": "the same synth on the .rfm1 engine", "file": "../../build/rfm1/felucca.rfm1",
   "expect": ["keys", "computer", "midi"],
   "save": {"steps": ["turn:2:3", "wait:1000", "tap:SAVE", "wait:800", "tap:OCT+", "wait:800", "tap:OCT+", "wait:2500"],
            "view": ["tap:HOME", "wait:600", "tap:SAVE", "wait:1200"], "screen": "differsFromFresh"},
   "other": "../../build/packages/felucca.fwsc"},
  {"id": "amb", "kind": "polyphonic synth, saves with a SAVE tap", "file": "../../build/packages/amb.fwsc",
   "expect": ["keys", "computer", "midi"],
   "save": {"steps": ["turn:2:2", "wait:800", "tap:SAVE", "wait:2500"], "view": ["wait:100"], "screen": "none"},
   "other": "../../build/rfm1/amb.rfm1"},
  {"id": "amenity", "kind": "sequencer that saves its settings by itself when a knob turns", "file": "../../build/packages/amenity.fwsc",
   "expect": ["play"],
   "save": {"steps": ["turn:3:5", "wait:3000"], "view": ["wait:100"], "screen": "none"}},
  {"id": "h1", "kind": "keyboard synth on the .rfm1 engine (built in)", "file": "../../Resources/h1.rfm1",
   "expect": ["keys", "computer"]},
  {"id": "atek303", "kind": "bass synth with a sequencer", "file": "../../build/packages/atek303.fwsc",
   "expect": ["keys", "computer", "midi"]},
  {"id": "hortator", "kind": "drum machine: starts with an empty pattern, so steps are entered first", "file": "../../build/packages/hortator.fwsc",
   "expect": ["pattern"],
   "custom": [{"name": "pattern", "steps": ["key:0+", "wait:120", "key:0-", "wait:150", "key:4+", "wait:120", "key:4-", "wait:150",
                                             "key:8+", "wait:120", "key:8-", "wait:150", "key:12+", "wait:120", "key:12-", "wait:150", "tap:PLAY"],
               "ms": 4000, "after": ["tap:PLAY"]}]},
  {"id": "hortator-rfm1", "kind": "the same drum machine on the .rfm1 engine", "file": "../../build/rfm1/hortator.rfm1",
   "expect": [],
   "custom": [{"name": "pattern", "steps": ["key:0+", "wait:120", "key:0-", "wait:150", "key:4+", "wait:120", "key:4-", "wait:150",
                                             "key:8+", "wait:120", "key:8-", "wait:150", "key:12+", "wait:120", "key:12-", "wait:150", "tap:PLAY"],
               "ms": 4000, "after": ["tap:PLAY"]}]},
  {"id": "choppah", "kind": "drum machine", "file": "../../build/packages/choppah.fwsc", "expect": ["keys", "play"]},
  {"id": "aetherfm1", "kind": "groovebox", "file": "../../build/packages/aetherfm1.fwsc", "expect": ["keys", "play"]},
  {"id": "ambpond", "kind": "generative instrument", "file": "../../build/packages/ambpond.fwsc", "expect": ["idle"]},
  {"id": "cursedos", "kind": "MIDI-dependent (plays from MIDI only)", "file": "../../build/packages/cursedos.fwsc", "expect": ["midi"]}
 ]
}
